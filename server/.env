# ============================================
# 应用配置
# ============================================
# 服务端口
APP_PORT=3000

# 运行环境: development | production | test
APP_ENV=production

# ============================================
# 数据库配置 (MySQL)
# ============================================
# 数据库主机地址
DB_HOST=172.18.0.2

# 数据库端口
DB_PORT=3306

# 数据库用户名
DB_USERNAME=

# 数据库密码
DB_PASSWORD=

# 数据库名称
DB_DATABASE=

# 是否自动同步数据库结构 (开发环境建议开启，生产环境请关闭)
DB_SYNCHRONIZE=true

# 是否开启SQL日志
DB_LOGGING=true

# ============================================
# JWT 认证配置
# ============================================
# JWT 密钥 (生产环境请使用复杂的随机字符串)
JWT_SECRET=your-secret-key-change-in-production

# Token 过期时间 (例如: 7d, 24h, 3600s)
JWT_EXPIRES_IN=7d
